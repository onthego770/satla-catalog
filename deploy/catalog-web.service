[Unit]
Description=Satla Catalog site (Flask via gunicorn) - catalog.satlaspirits.com
After=network.target

[Service]
Type=simple
User=dovid
WorkingDirectory=/home/dovid/python/catalog
ExecStart=/home/dovid/python/venvs/qbo311/bin/gunicorn --workers 1 --threads 8 --timeout 60 --bind 127.0.0.1:5001 catalog_web:app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
